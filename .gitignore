# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit these
.env
*.pem
*.key
id_rsa
id_ed25519

# Generated at runtime
logs/*.log
logs/*.log.*
reports/*
database/*.db
backups/
restore/

# Keep the directories themselves
!logs/.gitkeep
!reports/.gitkeep
!database/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
